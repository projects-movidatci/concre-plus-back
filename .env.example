NODE_ENV=development
PORT=3000

# URL completa de PostgreSQL (requerida por la app)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/concreto_db

# true en casi todos los PostgreSQL en la nube (Neon, Supabase, RDS, etc.)
DB_SSL=false

# Mínimo 8 caracteres; en producción usa un secreto largo y aleatorio
JWT_SECRET=cambiar_por_secreto_seguro_min_8_chars

# Ejemplos: 8h, 7d, 15m
JWT_EXPIRES_IN=8h
